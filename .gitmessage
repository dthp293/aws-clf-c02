
# <type>(<scope>): <summary>     ← imperative, lowercase, no period, ≤ 72 chars
#
# type:  feat | fix | content | i18n | docs | chore | test | refactor | style
# scope: app, srs, exam, practice, lessons, settings, i18n, questions, meta,
#        glossary, ui, en, ja, pwa, repo
#
# Body (optional): why this change, AWS source URL for changed facts.
# Wrap at 72 characters.
#
# Footer (optional):
#   BREAKING CHANGE: <effect on saved progress>
#   Co-Authored-By: <name> <email>
#
# One commit per role: content → app → ui strings → en → ja → pwa → docs.
# Full rules: CONTRIBUTING.md
